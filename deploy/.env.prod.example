# Production Compose environment для TicketBot.
# Compose-level переменные (например POSTGRES_PASSWORD) задаются здесь.
# Секреты контейнеров см. в .env.telegram.example / .env.vk.example / .env.max.example.
POSTGRES_PASSWORD=replace_with_a_strong_password

# ─── Telegram (.env.telegram) ─────────────────────────────
# DATABASE_URL=postgresql+asyncpg://tg_user:password@db:5432/ticketbot
# TELEGRAM_TOKEN=
# ADMIN_TELEGRAM_IDS=
# WEBAPP_URL=https://example.org
# VK_APP_ID=
# VK_SECRET_KEY=
# VK_TOKEN_ENCRYPTION_KEY=
# VK_PAY_ENABLED=false
# DEBUG=false

# ─── VK (.env.vk) ─────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://vk_user:password@db:5432/ticketbot
# VK_TOKEN=
# VK_GROUP_ID=
# DEBUG=false

# ─── MAX (.env.max) ───────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://max_user:password@db:5432/ticketbot
# MAX_TOKEN=
# DEBUG=false

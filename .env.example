# ═══════════════════════════════════════════════════════════════
# TicketBot — Compose-level environment variables
#
# Этот файл читается Docker Compose для значений ${...}, в частности
# пароля PostgreSQL. Настройки контейнеров читаются из env_file:
# .env.telegram (также Web), .env.vk и .env.max.
# ═══════════════════════════════════════════════════════════════

POSTGRES_PASSWORD=replace_with_a_strong_password
